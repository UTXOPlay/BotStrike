# syntax=docker/dockerfile:1
# Cosmetic Web Audio + trusted presentation metadata, exact retained V5 engine.
# Explicit final copies make the service change set reviewable. No native build.
ARG APPLICATION_IMAGE=botstrike:audio-v5-4cb119b7
FROM ${APPLICATION_IMAGE} AS bound
FROM bound AS web
USER root
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY botstrike ./botstrike
COPY botstrike-myelin ./botstrike-myelin
COPY botstrike-service ./botstrike-service
COPY shared ./shared
COPY games ./games
COPY assets ./assets
COPY public ./public
COPY host ./host
COPY game-host.json ./game-host.json
COPY tools ./tools
COPY tests ./tests
COPY docs/acceptance/arsenal-audio/presentation-binding.json ./presentation-binding.json
COPY docs/acceptance/arsenal-audio/gait-calibration.json ./docs/acceptance/arsenal-audio/gait-calibration.json
COPY --from=bound /app/release ./release
COPY --from=bound /app/botstrike/spec.json ./bound-spec.json
COPY --from=bound /app/dist/botstrike/damage-contract.json ./bound-damage.json
RUN cmp botstrike/spec.json bound-spec.json && node tools/check-presentation-binding.mjs && cp bound-damage.json games/botstrike/web/damage-contract.json
RUN npm test && npm run test:host && npm run build
FROM bound
COPY --from=web /work/dist /app/dist
COPY --from=web /work/botstrike-service/feedback.mjs /work/botstrike-service/server.mjs /work/botstrike-service/visibility.mjs /work/botstrike-service/movement-audio.mjs /app/botstrike-service/
COPY --from=web /work/shared/gait-plan.mjs /work/shared/gait-geometry.mjs /work/shared/ground-surfaces.mjs /work/shared/weapon-audio-events.mjs /app/shared/
