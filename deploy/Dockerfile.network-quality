# syntax=docker/dockerfile:1
# Overlay service/UI changes on the exact portable pair and retained verifiers.
ARG APPLICATION_IMAGE=botstrike:interface-v5-20261107-v3
ARG RUST_IMAGE=rust:1.98.1-bookworm@sha256:c49256cbe5ea0188bc658a689500d70c41eb51f009a7a7be209caf60a944f3ec
FROM ${APPLICATION_IMAGE} AS bound
FROM ${RUST_IMAGE} AS validation
COPY --from=bound /usr/local/bin/node /usr/local/bin/node
COPY --from=bound /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY botstrike ./botstrike
COPY botstrike-myelin ./botstrike-myelin
COPY botstrike-service ./botstrike-service
COPY host ./host
COPY shared ./shared
COPY games ./games
COPY assets ./assets
COPY public ./public
COPY tools ./tools
COPY tests ./tests
COPY docs ./docs
COPY game-host.json ./game-host.json
# Generated offline object fixture; only validation gets repository metadata.
COPY validation-git /validation-git
RUN node tools/prepare-quality-validation-git.mjs --verify /validation-git --link-worktree /work
COPY --from=bound /app/release ./release
# Preserve the portable guide generated by this exact retained engine.
COPY --from=bound /app/dist/botstrike/damage-contract.json ./games/botstrike/web/damage-contract.json
ARG SOURCE_REVISION
ENV BOTSTRIKE_SOURCE_REVISION=${SOURCE_REVISION} BOTSTRIKE_SOURCE_KIND=git_tree BOTSTRIKE_OPS_REQUIRE_BUNDLE=1
RUN mkdir -p build-validation/network-quality && npm run build
RUN node tools/quality-rollback-bundle.mjs --build /validation-git /work/build-validation/network-quality/rollback-source
# Includes the independent Rust inspector, not a replacement game engine build.
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git \
    node --test --test-concurrency=2 tests/*.test.mjs > build-validation/network-quality/unit.tap || { cat build-validation/network-quality/unit.tap; exit 1; }
RUN npm run test:host > build-validation/network-quality/host.tap || { cat build-validation/network-quality/host.tap; exit 1; }
RUN cp /tmp/botstrike-network-audit-target/release/examples/network_audit tools/network-audit-inspector && chmod 0755 tools/network-audit-inspector
RUN node tools/quality-release-binding.mjs build-validation/network-quality/binding.json

FROM bound
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} io.utxoplay.source-kind=git_tree
COPY --from=validation /work/dist /app/dist
COPY --from=validation /work/botstrike-service /app/botstrike-service
COPY --from=validation /work/host /app/host
COPY --from=validation /work/shared /app/shared
COPY --from=validation /work/tools /app/tools
COPY --from=validation /work/tests /app/tests
COPY --from=validation /work/botstrike /app/botstrike
COPY --from=validation /work/botstrike-myelin /app/botstrike-myelin
COPY --from=validation /work/games/botstrike/client /app/games/botstrike/client
COPY --from=validation /work/docs /app/docs
COPY --from=validation /work/game-host.json /app/game-host.json
COPY --from=validation /work/build-validation/network-quality /app/build-validation/network-quality
ENV BOTSTRIKE_SOURCE_REVISION=${SOURCE_REVISION} BOTSTRIKE_SOURCE_KIND=git_tree BOTSTRIKE_OPS_REQUIRE_BUNDLE=1
RUN test ! -e /app/.git && test ! -e /validation-git && test ! -e /app/validation-git && ! command -v git && ! command -v cargo
# The base image still supplies the exact, unchanged release directory and user.
USER node
